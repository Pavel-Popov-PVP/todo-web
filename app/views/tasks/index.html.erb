<h1>My tasks list</h1>

<table class="tasks-table">

  <thead>
    <tr>
      <th> ID </th>
      <th> Task </th>
      <th> Status </th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
    <tr>
      <td><%= task.id %></td>
      <td><%= link_to task.title, task %></td>
      <td><%= task.is_completed? ? "done" : "in progress" %></td>
    </tr>
  <% end %>
  </tbody>

</table>

<button><%= link_to "Add new task", new_task_path %></button>