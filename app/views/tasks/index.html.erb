<h1>My tasks list</h1>

<%= link_to "Add new task", new_task_path, class: "btn" %>

<table class="tasks-table">

  <thead>
    <tr>
      <th> 
        ID 
        <%= link_to "↑", tasks_path(order: "asc"), class: "sort-btn" %>
        <%= link_to "↓", tasks_path(order: "desc"), class: "sort-btn" %>
      </th>
      <th> Task </th>
      <th> Status </th>
      <th> Actions </th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
    <tr>
      <td><%= task.id %></td>
      <td><%= link_to task.title, task %></td>
      <td><%= task.is_completed? ? "done" : "in progress" %></td>
      <td><%= link_to "Edit task", edit_task_path(task), class: "btn" %>
        <%= button_to "Destroy",
          task_path(task),
          method: :delete,
          form: { onsubmit: "return confirm('Are you sure?')" },
          class: "btn btn-danger" %>
      </td>
    </tr>
  <% end %>
  </tbody>

</table>