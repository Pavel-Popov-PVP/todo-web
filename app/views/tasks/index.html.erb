<h1>My tasks list</h1>

<table>

  <thead>
    <tr>
      <th> ID </th>
      <th> Task </th>
      <th> Status </th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
    <tr>
      <td><%= task.id %></td>
      <td><%= task.title %></td>
      <td><%= task.is_completed? ? "done" : "in progress" %></td>
    </tr>
  <% end %>
  </tbody>

</table>